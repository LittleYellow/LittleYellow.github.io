---
import '../styles/global.css';
interface Props { title?: string; description?: string; article?: boolean; date?: Date; noindex?: boolean }
const { title, description = '嘴上吐槽，手上解題。從個人做得出來，到企業用得起來：小黃的企業 AI、工程實務與值班日常。', article = false, date, noindex = false } = Astro.props;
const name = '小黃｜黃柴值班中';
const fullTitle = title ? title + ' — ' + name : name + '・把 AI 帶進真實工作';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const links = [{url:'/posts/',label:'所有文章'},{url:'/enterprise-ai/',label:'企業 AI 導讀'},{url:'/about/',label:'關於小黃'}];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title><meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fff9ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2025" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={name} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} /><meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={new URL('/images/og-cover.png', Astro.site)} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="小黃｜黃柴值班中，戴圓框眼鏡的工程柴" />
    <meta name="twitter:card" content="summary_large_image" />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <header class="site-header wrap">
      <a href="/" class="brand" aria-label="小黃｜黃柴值班中，回首頁"><img src="/images/shiba-avatar.webp" alt="" width="48" height="48" /><span>小黃<span class="brand-divider"> / </span><span class="brand-sub">黃柴值班中</span><small>LITTLE YELLOW · ON DUTY</small></span></a>
      <nav aria-label="主要導覽">{links.map(link => <a href={link.url} aria-current={path.startsWith(link.url) ? 'page' : undefined}>{link.label}</a>)}</nav>
      <a class="header-rss" href="/rss.xml" aria-label="訂閱 RSS">RSS <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href="/">小黃<span>｜黃柴值班中</span></a><p>嘴上吐槽，手上解題。明天繼續值班。</p></div>
      <div class="footer-links"><a href="/posts/">所有文章</a><a href="/about/">關於小黃</a><a href="https://github.com/LittleYellow">GitHub ↗</a><a href="/rss.xml">RSS ↗</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Little Yellow</span><span>慢慢理解，好好實作。 <i class="status-dot" aria-hidden="true"></i></span></div>
    </footer>
  </body>
</html>
