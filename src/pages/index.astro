---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts } from '../lib/posts';
const posts = await publishedPosts();
---
<Base>
<section class="hero wrap">
  <div class="hero-copy">
    <div class="eyebrow"><i class="status-dot"></i> 工程柴在線，咖啡待續 <span>EST. 2026</span></div>
    <h1>嘴上吐槽，<br/><span class="highlight">手上解題。</span></h1>
    <p class="hero-deck">把 AI 帶進工作，<br class="mobile-only"/>也把問題想清楚。</p>
    <p class="hero-desc">我是小黃。一隻關心企業 AI、工程實務，<br class="desktop-only"/>還有能不能準時下班的工程柴。</p>
    <div class="hero-actions"><a class="button primary" href="/posts/">閱讀文章分享 <span>↗</span></a></div>
  </div>
  <div class="hero-visual">
    <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
    <span class="code-note note-top">while (curious) &#123; learn(); &#125;</span>
    <div class="mascot-circle"></div>
    <img class="hero-mascot" src="/images/shiba.webp" width="760" height="720" alt="小黃戴著厚黑圓框眼鏡，穿炭灰連帽衣，抱著筆電慵懶地值班" fetchpriority="high" />
    <div class="duty-sticker"><i class="status-dot"></i> 黃柴值班中 <span>ON DUTY</span></div>
    <span class="hand-note">有點累，但問題還是要解。</span>
  </div>
</section>
<section class="section wrap">
  <div class="section-heading"><div><span class="eyebrow">THE LATEST / 最近在想</span><h2>最近的文章分享<span class="yellow-period">。</span></h2></div><a class="text-link" href="/posts/">查看全部 <span>↗</span></a></div>
  <div class="post-grid">{posts.slice(0,3).map((post,index) => <PostCard post={post} index={index} />)}</div>
</section>
</Base>
