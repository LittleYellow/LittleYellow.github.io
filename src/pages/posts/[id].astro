---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, formatDate } from '../../lib/posts';
export async function getStaticPaths() { return (await publishedPosts()).map(post => ({ params: { id: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await publishedPosts()).filter(p => p.id !== post.id).slice(0,2);
const structured = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), author: {'@type':'Person',name:'小黃',url:new URL('/about/',Astro.site).href}, image:new URL('/images/og-cover.png',Astro.site).href,mainEntityOfPage:new URL(Astro.url.pathname,Astro.site).href };
---
<Base title={post.data.title} description={post.data.description} article date={post.data.date}>
  <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')} />
  <header class="article-header wrap"><a class="back-link" href="/posts/">← 文章分享</a><div class="meta"><a href={'/posts/?category='+encodeURIComponent(post.data.category)}>{post.data.category}</a><span>{post.data.minutes} 分鐘閱讀</span></div><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="author-line"><img src="/images/shiba-avatar.webp" width="42" height="42" alt="" /><span>小黃 <span class="muted">／ 黃柴值班中</span></span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div></header>
  <div class="article-layout wrap"><aside class="toc"><span class="eyebrow">這篇聊什麼</span><nav aria-label="文章目錄">{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav></aside><article class="prose"><Content/><div class="article-end"><span>— 這班先記到這裡。</span><p>{post.data.tags.map(tag=><span class="tag">#{tag}</span>)}</p><button id="copy-link" class="button outline" type="button">複製文章連結 ↗</button><p id="copy-status" aria-live="polite"></p></div></article></div>
  <section class="wrap related"><div class="section-heading"><h2>下一篇，繼續拆解。</h2><a class="text-link" href="/posts/">文章分享 ↗</a></div>{related.map(p=><a class="related-row" href={'/posts/'+p.id+'/'}><span>{p.data.category}</span><h3>{p.data.title}</h3><b>↗</b></a>)}</section>
</Base>
<script>
document.querySelector('#copy-link')?.addEventListener('click', async () => {
  const status = document.querySelector('#copy-status')!;
  try { await navigator.clipboard.writeText(location.href); status.textContent = '連結已複製，可以分享了。'; }
  catch { status.textContent = '請從瀏覽器網址列複製：' + location.href; }
});
</script>
