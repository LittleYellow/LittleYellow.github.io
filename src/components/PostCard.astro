---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; index?: number }
const { post, index = 0 } = Astro.props;
---
<article class="post-card">
  <a href={'/posts/' + post.id + '/'} class="post-card-link">
    <div class:list={['card-art', 'art-' + (index % 3)]} aria-hidden="true">
      <span class="art-label">{post.data.category === '企業 AI' ? 'AI / FIELD NOTES' : post.data.category === '工程筆記' ? 'BUILD / VERIFY' : 'ON DUTY / NOTES'}</span>
      {index % 3 === 0 ? <div class="flow-art"><span>想法</span><b>→</b><span>試作</span><b>→</b><span class="selected">上線<span class="tiny-dot"></span></span></div> : index % 3 === 1 ? <div class="check-art"><span>✓ 功能正常</span><span>✓ 失敗有紀錄</span><span class="last-check">□ 可以放心下班？</span></div> : <div class="note-art"><span>今日值班筆記</span><b>把問題寫下來，<br/>讓下次少猜一點。</b><span class="note-line"></span></div>}
      <span class="art-number">0{index + 1}</span>
    </div>
    <div class="card-copy"><div class="meta"><span>{post.data.category}</span><span>{post.data.minutes} 分鐘閱讀</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="card-bottom"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span aria-hidden="true">↗</span></div></div>
  </a>
</article>
